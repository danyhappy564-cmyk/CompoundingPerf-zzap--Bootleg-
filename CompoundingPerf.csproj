<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CompoundingPerf</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.2.2</Version>
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Mono-repo: exclude sibling folders from server compile globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);client\**;tests\**;scripts\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Dev benchmark builds: dotnet build -p:Bench=true compiles in the server-side
       bench sampler (GC pauses, feature counters → user/logs JSONL). Release packages
       are built WITHOUT this flag and contain no sampler. Mirrors the client csproj. -->
  <PropertyGroup Condition="'$(Bench)' == 'true'">
    <DefineConstants>$(DefineConstants);BENCH</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPT 4.1 renamed the server packages SPTarkov.* -> SPTushonka.*; the namespaces
         inside them are unchanged. -->
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
    <!-- 0Harmony ships with the SPT server runtime; Lib.Harmony is the standard NuGet
         that exposes the `HarmonyLib` API we compile against. Marked PrivateAssets
         so we don't try to copy it next to our DLL — the runtime already has it.

         2.3.3 -> 2.4.2 for 4.1: the SPT server moved to net10.0, where
         System.Reflection.Emit.LocalBuilder became abstract, and 2.3.3 throws
         MemberAccessException the moment it tries to declare a local while building a
         patch. Verified by running 2.3.3 against the 4.1.5 assemblies here. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Auto-deploy: copy the server DLL + config.json to the live SPT mods folder. -->
  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
  </PropertyGroup>

  <!-- Auto-deploy: copy the server DLL + config.json to the live SPT mods folder.
       Skip by passing -p:SkipDeploy=true (useful when SPT.Server is running and
       holding a file lock — tests + builds still succeed, just no live deploy). -->
  <Target Name="DeployToSpt" AfterTargets="PostBuildEvent" Condition="'$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <ServerDeployDir>$(SptRoot)\SPT_Runtime\user\mods\CompoundingPerf\</ServerDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(ServerDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerDeployDir)" SkipUnchangedFiles="false"
          ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\config.json" DestinationFolder="$(ServerDeployDir)" SkipUnchangedFiles="false"
          ContinueOnError="WarnAndContinue" />
    <Message Text="Deployed $(TargetFileName) + config.json to $(ServerDeployDir)" Importance="high" />
  </Target>


  <!--
    Rule 2-2: every Release build also drops a ready-to-ship archive in release/, laid out
    like the SPT folder so it extracts straight into it:
      SPT_Runtime/user/mods/CompoundingPerf/   server dll + config.json
      BepInEx/plugins/CompoundingPerf.Client/  F12 settings plugin
    The client half needs the game's assemblies under SptRoot; without them (e.g. a CI box)
    the archive carries the server half only and says so. Skip with -p:SkipPackage=true.
  -->
  <PropertyGroup>
    <ClientProject>$(MSBuildThisFileDirectory)client\CompoundingPerf.Client.csproj</ClientProject>
    <CanBuildClient Condition="Exists('$(SptRoot)\BepInEx\core\BepInEx.dll') AND Exists('$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll')">true</CanBuildClient>
  </PropertyGroup>

  <Target Name="PackageRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageServerDir>$(PackageStageDir)SPT_Runtime\user\mods\CompoundingPerf\</PackageServerDir>
      <PackageClientDir>$(PackageStageDir)BepInEx\plugins\CompoundingPerf.Client\</PackageClientDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)$(AssemblyName)-$(Version).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json;$(OutputPath)**\*.staticwebassets.*.json" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFiles="@(PackageFiles->'$(PackageServerDir)%(RecursiveDir)%(Filename)%(Extension)')" />

    <!-- Restore must run in its own evaluation before Build sees the assets file. -->
    <MSBuild Projects="$(ClientProject)" Condition="'$(CanBuildClient)' == 'true'"
             Properties="Configuration=Release;SptRoot=$(SptRoot);_ClientRestore=true" Targets="Restore" />
    <MSBuild Projects="$(ClientProject)" Condition="'$(CanBuildClient)' == 'true'"
             Properties="Configuration=Release;SptRoot=$(SptRoot);SkipDeploy=$(SkipDeploy)" Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="ClientDll" />
    </MSBuild>
    <Copy SourceFiles="@(ClientDll)" DestinationFolder="$(PackageClientDir)" Condition="'$(CanBuildClient)' == 'true'" />
    <Warning Condition="'$(CanBuildClient)' != 'true'"
             Text="Game assemblies not found under $(SptRoot) - the archive has the server mod only, without the F12 plugin." />

    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
